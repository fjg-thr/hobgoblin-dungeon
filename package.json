{
  "name": "dark-isometric-dungeon-prototype",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/next-dev-clean-env.mjs",
    "build": "next build",
    "smoke:dev": "node scripts/smoke-dev-server.mjs",
    "smoke:prod": "node scripts/smoke-prod-server.mjs",
    "test:smoke": "node --test scripts/smoke-dev-server.test.mjs scripts/smoke-prod-server.test.mjs",
    "test:smoke-dev": "node --test scripts/smoke-dev-server.test.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "process:assets": "python3 tools/process_assets.py",
    "process:death-assets": "node tools/process_actor_death_assets.mjs",
    "process:combat-juice": "node tools/process_combat_juice_assets.mjs",
    "generate:powerups": "node tools/generate_powerup_sprites.mjs",
    "generate:combat-assets": "node tools/generate_brute_ammo_sprites.mjs"
  },
  "dependencies": {
    "next": "16.2.6",
    "phaser": "4.0.0-rc.4",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "6.0.3"
  },
  "overrides": {
    "postcss": "8.5.15"
  },
  "packageManager": "pnpm@11.3.0"
}
