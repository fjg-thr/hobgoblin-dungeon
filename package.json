{
  "name": "dark-isometric-dungeon-prototype",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "test": "rm -rf tmp/test-dist && tsc --ignoreConfig --target es2020 --module Node16 --moduleResolution Node16 --types node --skipLibCheck --esModuleInterop --outDir tmp/test-dist src/game/maps/startingDungeon.test.ts src/game/scenes/input.test.ts && node --test tmp/test-dist/maps/startingDungeon.test.js tmp/test-dist/scenes/input.test.js",
    "process:assets": "python3 tools/process_assets.py",
    "process:death-assets": "node tools/process_actor_death_assets.mjs",
    "process:combat-juice": "node tools/process_combat_juice_assets.mjs",
    "generate:powerups": "node tools/generate_powerup_sprites.mjs",
    "generate:combat-assets": "node tools/generate_brute_ammo_sprites.mjs"
  },
  "dependencies": {
    "next": "^16.3.0-canary.28",
    "phaser": "4.0.0-rc.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.0-canary.28",
    "typescript": "^6.0.3"
  }
}
