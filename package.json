{
  "name": "dark-isometric-dungeon-prototype",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate:assets": "node scripts/generate-required-assets.mjs",
    "validate:assets": "node scripts/validate-assets.mjs",
    "predev": "npm run generate:assets",
    "dev": "next dev",
    "prebuild": "npm run generate:assets && npm run validate:assets",
    "build": "next build",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "process:assets": "python3 tools/process_assets.py",
    "process:death-assets": "node tools/process_actor_death_assets.mjs",
    "process:combat-juice": "node tools/process_combat_juice_assets.mjs",
    "generate:powerups": "node tools/generate_powerup_sprites.mjs",
    "generate:combat-assets": "node tools/generate_brute_ammo_sprites.mjs"
  },
  "dependencies": {
    "next": "^16.2.6",
    "phaser": "4.0.0-rc.4",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest"
  },
  "overrides": {
    "postcss": "8.5.15"
  }
}
